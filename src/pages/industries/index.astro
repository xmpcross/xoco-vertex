---
import { Image } from "astro:assets";
import Arrow from "@/components/ui/Arrow.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getIndustries, industryHref } from "@/lib/catalog";

const industries = await getIndustries();
---

<BaseLayout title="Industries" description="Sector teams in financial services, healthcare, energy, industrials, consumer and technology, who know your market, your regulators and your numbers.">
  <PageHeader
    eyebrow="Industries"
    title={["Sector teams who know", "your market"]}
    lead="Every engagement pairs our functional practices with partners who have spent their careers in your industry, and who bring benchmarks from dozens of companies like yours."
    crumbs={[{ label: "Industries", href: "/industries/" }]}
  />

  <section class="section">
    <ul class="shell grid gap-x-6 gap-y-14 md:grid-cols-2">
      {
        industries.map((industry, index) => {
          const [figure] = industry.data.figures;
          return (
            <li class="reveal" style={`--i:${index % 2}`}>
              <a href={industryHref(industry)} class="group block">
                <span class="media relative block aspect-16/10">
                  <Image src={industry.data.cover} alt="" widths={[640, 960, 1280]} sizes="(min-width: 82rem) 40rem, (min-width: 48rem) 46vw, 92vw" class="size-full object-cover transition-transform duration-1000 ease-(--ease-out-expo) group-hover:scale-[1.04]" />
                  <span class="absolute top-4 left-4 grid size-11 place-items-center rounded-sm bg-white text-ink">
                    <Icon name={industry.data.icon} class="size-5" />
                  </span>
                  {figure && (
                    <span class="result absolute bottom-4 left-4 bg-white! text-ink!">
                      <span class="font-semibold">{figure.value}</span>
                      <span class="text-muted">{figure.label}</span>
                    </span>
                  )}
                </span>
                <span class="mt-6 flex items-start justify-between gap-6">
                  <span>
                    <span class="block text-display-md">{industry.data.title}</span>
                    <span class="mt-2 block max-w-md text-muted">{industry.data.summary}</span>
                  </span>
                  <span class="mt-2 grid size-10 shrink-0 place-items-center rounded-sm ring-1 ring-line-strong transition-colors group-hover:bg-ink group-hover:text-white group-hover:ring-ink">
                    <Arrow />
                  </span>
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>

  <CtaBand />
</BaseLayout>
