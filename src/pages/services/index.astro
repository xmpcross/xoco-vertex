---
import { Image } from "astro:assets";
import Approach from "@/components/home/Approach.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getServices, serviceHref } from "@/lib/catalog";

const services = await getServices();
---

<BaseLayout title="Services" description="Six practices, one team: strategy, operations, digital and AI, transformation, mergers and acquisitions, and people and organization.">
  <PageHeader
    eyebrow="Services"
    title={["Six practices,", "staffed as one team"]}
    lead="We build each engagement around the question, not the practice. Most draw on two or three of these, led by one partner who answers for the result."
    crumbs={[{ label: "Services", href: "/services/" }]}
  >
    <ul class="rise mt-12 flex flex-wrap gap-2" style="--i:3">
      {
        services.map((service) => (
          <li>
            <a href={`#${service.id}`} class="tag gap-2 transition-colors hover:bg-white/15">
              <Icon name={service.data.icon} class="size-3.5" />
              {service.data.title}
            </a>
          </li>
        ))
      }
    </ul>
  </PageHeader>

  <section class="section">
    <div class="shell grid gap-6">
      {
        services.map((service, index) => (
          <article id={service.id} class="reveal grid gap-8 border-b border-line pb-6 last:border-b-0 lg:grid-cols-12 lg:gap-10 lg:pb-6">
            <a href={serviceHref(service)} class="media group block aspect-16/10 lg:col-span-5 lg:aspect-auto lg:min-h-[24rem]" tabindex="-1" aria-hidden="true">
              <Image src={service.data.cover} alt="" widths={[480, 720, 1080, 1600]} sizes="(min-width: 64rem) 52rem, 92vw" class="size-full object-cover transition-transform duration-1000 ease-(--ease-out-expo) group-hover:scale-[1.04]" />
            </a>
            <div class="flex flex-col lg:col-span-7 lg:py-4">
              <p class="flex items-center gap-3 text-sm text-muted">
                <span>{String(index + 1).padStart(2, "0")}</span>
                <span class="h-px w-8 bg-line-strong" />
                <Icon name={service.data.icon} class="size-4 text-ink" />
              </p>
              <h2 class="text-display-md mt-5">
                <a href={serviceHref(service)} class="link">
                  {service.data.title}
                </a>
              </h2>
              <p class="mt-3 max-w-xl text-lead text-muted">{service.data.description}</p>
              {service.data.questions.length > 0 && (
                <ul class="mt-6 grid max-w-xl gap-2 text-[0.9375rem]">
                  {service.data.questions.slice(0, 3).map((question) => (
                    <li class="flex gap-3">
                      <Icon name="check" class="mt-1 size-4 text-accent-ink" />
                      {question}
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-auto flex flex-wrap items-center justify-between gap-4 pt-8">
                <div class="flex flex-wrap gap-2">
                  {service.data.outcomes.slice(0, 2).map((outcome) => (
                    <span class="result">
                      <span class="font-semibold">{outcome.value}</span>
                      <span class="font-normal">{outcome.label}</span>
                    </span>
                  ))}
                </div>
                <a href={serviceHref(service)} class="btn btn-outline btn-sm">
                  Explore the practice
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <Approach />
  <CtaBand />
</BaseLayout>
