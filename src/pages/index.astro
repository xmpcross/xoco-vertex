---
import Approach from "@/components/home/Approach.astro";
import Credentials from "@/components/home/Credentials.astro";
import Hero from "@/components/home/Hero.astro";
import Why from "@/components/home/Why.astro";
import WorkSlices from "@/components/home/WorkSlices.astro";
import InsightCard from "@/components/insights/InsightCard.astro";
import PersonCard from "@/components/people/PersonCard.astro";
import ServiceGrid from "@/components/services/ServiceGrid.astro";
import CtaBand from "@/components/ui/CtaBand.astro";
import Faq from "@/components/ui/Faq.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { home } from "@/config/home";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getServices } from "@/lib/catalog";
import { joinNames } from "@/lib/format";
import { authorsOf, getInsights, upcomingEvents } from "@/lib/insights";
import { getPeople, peopleById } from "@/lib/people";

const services = await getServices();
const people = await getPeople();
const byId = peopleById(people);
const entries = await getInsights();
const leaders = people.filter((person) => person.data.group === "Leadership").slice(0, 4);

/* The next event, then the newest report and article. */
const event = upcomingEvents(entries)[0];
const report = entries.find((entry) => entry.data.type === "reports");
const article = entries.find((entry) => entry.data.type === "articles");
const picks = [article, report, event].filter((entry) => entry !== undefined);
---

<BaseLayout tone="dark">
  <Hero />
  <Credentials />
  <WorkSlices />

  <section class="section pt-0!">
    <div class="shell">
      <SectionHead eyebrow={home.services.eyebrow} title={home.services.title} lead={home.services.lead} align="center" />
      <div class="mt-14 lg:mt-20">
        <ServiceGrid services={services} />
      </div>
    </div>
  </section>

  <Approach />
  <Why />

  <section class="section bg-wash">
    <div class="shell">
      <SectionHead eyebrow={home.insights.eyebrow} title={home.insights.title} link={{ label: "All insights", href: "/insights/" }} />
      <ul class="mt-12 grid gap-x-6 gap-y-14 md:grid-cols-3 lg:mt-16">
        {
          picks.map((entry, index) => (
            <li class="reveal" style={`--i:${index}`}>
              <InsightCard entry={entry} byline={joinNames(authorsOf(entry, byId).map((person) => person.data.name))} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="shell">
      <SectionHead eyebrow={home.people.eyebrow} title={home.people.title} link={{ label: "Meet our people", href: "/people/" }} />
      <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-10 lg:mt-16 lg:grid-cols-4 lg:gap-x-6">
        {
          leaders.map((person, index) => (
            <li class="reveal" style={`--i:${index}`}>
              <PersonCard person={person} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section border-t border-line">
    <div class="shell">
      <Faq eyebrow={home.faq.eyebrow} title={home.faq.title} items={home.faq.items} />
    </div>
  </section>

  <CtaBand />
</BaseLayout>
