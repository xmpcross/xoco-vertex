---
import { home } from "@/config/home";
---

<section class="shell pt-16 lg:pt-20" aria-label="Vertex in numbers">
  <dl class="credentials grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6">
    {
      home.credentials.map((item, index) => (
        <div class="reveal flex flex-col justify-between gap-6 p-5 sm:p-6" style={`--i:${index}`}>
          <dt class="order-2 text-sm leading-snug text-muted">{item.label}</dt>
          <dd class="order-1 text-[clamp(1.75rem,1.4rem+1.2vw,2.4rem)] leading-none tracking-[-0.04em]">{item.value}</dd>
        </div>
      ))
    }
  </dl>
</section>

<style>
  /* Cells share their borders, so the grid reads as one ruled table at any column count. */
  .credentials {
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .credentials > div {
    min-height: 9.5rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
</style>
