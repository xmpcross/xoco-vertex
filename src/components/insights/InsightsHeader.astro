---
import Icon from "@/components/ui/Icon.astro";
import PageHeader from "@/components/ui/PageHeader.astro";
import { insightTypes, insightTypeKeys, type InsightType } from "@/config/insights";
import { typeHref } from "@/lib/insights";

interface Props {
  /** The type being shown, or none for every insight. */
  current?: InsightType;
}

const { current } = Astro.props;
const tabs = [
  { label: "All", href: "/insights/", active: !current },
  ...insightTypeKeys.map((key) => ({ label: insightTypes[key].label, href: typeHref(key), active: key === current })),
];
const crumbs = [{ label: "Insights", href: "/insights/" }, ...(current ? [{ label: insightTypes[current].label, href: typeHref(current) }] : [])];
---

<PageHeader
  glass={4}
  eyebrow="Insights"
  title={current ? insightTypes[current].label : ["Thinking from", "our partners"]}
  lead={current ? insightTypes[current].description : "Points of view, research and briefings on the questions boards are asking, written by the people who answer them for clients."}
  crumbs={crumbs}
  class="pb-0"
>
  <div class="rise mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-night-line pt-5" style="--i:3">
    <nav aria-label="Insight types" class="-mx-(--gutter) flex gap-1.5 overflow-x-auto px-(--gutter) [scrollbar-width:none] sm:mx-0 sm:px-0">
      {
        tabs.map((tab) => (
          <a href={tab.href} class:list={["tab", tab.active && "is-active"]} aria-current={tab.active ? "page" : undefined}>
            {tab.label}
          </a>
        ))
      }
    </nav>
    <button type="button" class="group hidden items-center gap-3 rounded-sm bg-white/6 py-2 pr-2 pl-3 text-sm text-night-muted ring-1 ring-white/10 transition hover:text-night-ink sm:inline-flex" data-search-open>
      <Icon name="search" class="size-4" />
      Search insights
      <kbd class="rounded-[3px] bg-white/10 px-1.5 py-0.5 font-sans text-xs">/</kbd>
    </button>
  </div>
</PageHeader>

<style>
  .tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 0.95rem;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--night-muted);
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .tab:hover {
    color: var(--night-ink);
    background: rgb(255 255 255 / 0.06);
  }

  .tab.is-active {
    background: #fff;
    color: var(--ink);
  }
</style>
