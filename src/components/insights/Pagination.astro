---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  current: number;
  last: number;
  /** Page 1 of the archive, e.g. `/insights/`. Later pages add `N/`. */
  base: string;
}

const { current, last, base } = Astro.props;
const href = (page: number) => (page === 1 ? base : `${base}${page}/`);
---

{
  last > 1 && (
    <nav aria-label="Pagination" class="mt-20 flex items-center justify-between gap-6 border-t border-line pt-6">
      {current > 1 ? (
        <a href={href(current - 1)} class="group inline-flex items-center gap-2 font-medium">
          <Icon name="arrow-left" class="size-4" />
          <span class="link">Newer</span>
        </a>
      ) : (
        <span />
      )}
      <ol class="flex gap-1">
        {Array.from({ length: last }, (_, i) => i + 1).map((page) => (
          <li>
            <a
              href={href(page)}
              aria-current={page === current ? "page" : undefined}
              aria-label={`Page ${page}`}
              class:list={["grid size-10 place-items-center rounded-sm text-sm", page === current ? "bg-ink text-white" : "text-muted hover:bg-wash hover:text-ink"]}
            >
              {page}
            </a>
          </li>
        ))}
      </ol>
      {current < last ? (
        <a href={href(current + 1)} class="group inline-flex items-center gap-2 font-medium">
          <span class="link">Older</span>
          <Icon name="arrow-right" class="size-4" />
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}
